import { readFileSync, writeFileSync } from 'node:fs'
import { dirname, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

import {
  type AuthorityRows,
  EXPECTED_OWNER_AUTHORITATIVE_MIMMA_V2_SHA256,
  type OwnerAuthorityHistory,
  readOwnerAuthorityHistory,
} from './owner-authority-history.mts'

/**
 * Renders migrations/0007_owner_authoritative_mimma_v2.sql from the hash-pinned v2 owner record.
 * The migration only appends: new games, new score versions, the v2 snapshot, and new mappings.
 * Checks the committed migration by default; pass --write to regenerate it.
 */

const repositoryRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..')
export const v2MigrationPath = resolve(
  repositoryRoot,
  'migrations/0007_owner_authoritative_mimma_v2.sql',
)
const catalogPath = resolve(repositoryRoot, 'data/catalog-release-v1.json')

function sqlString(value: string): string {
  return `'${value.replaceAll("'", "''")}'`
}

function sqlList(values: readonly string[]): string {
  return values.map(sqlString).join(', ')
}

/** Each new Steam mapping must point at the catalog game with that Steam app ID. */
export function assertMappingsMatchCatalog(
  rows: AuthorityRows,
  catalog: readonly { id: string; steamAppId: number }[],
): void {
  for (const mapping of rows.mappings) {
    const game = catalog.find((candidate) => candidate.id === mapping.catalogGameId)
    if (game === undefined || String(game.steamAppId) !== mapping.externalId) {
      throw new Error(`${mapping.id} does not match catalog game ${mapping.catalogGameId}`)
    }
  }
}

export function renderOwnerAuthoritativeMimmaV2Sql(history: OwnerAuthorityHistory): string {
  const added = history.v2Rows
  const [snapshot] = added.snapshots
  const prior = history.rows.snapshots.find((row) => row.version === snapshot.version - 1)
  if (prior === undefined) throw new Error('v2 needs the v1 snapshot before it')
  const newScoreIds = new Set(added.scores.map((score) => score.id))
  const reused = added.members.filter((member) => !newScoreIds.has(member.scoreId))

  const predicates = [
    `(SELECT COUNT(*) FROM authoritative_snapshots
    WHERE id = ${sqlString(prior.id)} AND version = ${prior.version} AND state = 'frozen') <> 1`,
    `EXISTS (SELECT 1 FROM authoritative_snapshots
    WHERE id = ${sqlString(snapshot.id)} OR version >= ${snapshot.version})`,
    `EXISTS (SELECT 1 FROM authoritative_mimma_score_versions WHERE id IN (${sqlList([...newScoreIds])}))`,
  ]
  if (added.games.length > 0) {
    predicates.push(`EXISTS (SELECT 1 FROM authoritative_games
    WHERE id IN (${sqlList(added.games.map((game) => game.id))})
      OR identity_key IN (${sqlList(added.games.map((game) => game.identityKey))})
      OR canonical_title IN (${sqlList(added.games.map((game) => game.canonicalTitle))}))`)
  }
  if (added.mappings.length > 0) {
    const pairs = added.mappings
      .map((mapping) => `(${sqlString(mapping.catalogGameId)}, ${sqlString(mapping.externalId)})`)
      .join(', ')
    predicates.push(`(SELECT COUNT(*) FROM (VALUES ${pairs}) AS expected
    INNER JOIN games AS catalog ON catalog.id = expected.column1
      AND CAST(catalog.steam_app_id AS TEXT) = expected.column2) <> ${added.mappings.length}`)
    predicates.push(`EXISTS (SELECT 1 FROM authoritative_game_mappings
    WHERE id IN (${sqlList(added.mappings.map((mapping) => mapping.id))})
      OR game_id IN (${sqlList(added.mappings.map((mapping) => mapping.gameId))}))`)
  }
  if (reused.length > 0) {
    const pairs = reused
      .map((member) => `(${sqlString(member.gameId)}, ${sqlString(member.scoreId)})`)
      .join(', ')
    predicates.push(`(SELECT COUNT(*) FROM (VALUES ${pairs}) AS expected
    INNER JOIN authoritative_mimma_score_versions AS score
      ON score.game_id = expected.column1 AND score.id = expected.column2) <> ${reused.length}`)
  }

  const statements = [
    `-- Generated by scripts/generate-owner-authoritative-mimma-v2.mts. Do not edit.
-- source_manifest_version: ${snapshot.manifestVersion}
-- source_hash: ${snapshot.sourceHash}
-- owner-authoritative v2 preflight: the database must hold exactly the frozen v1 history.
-- abs(INT64_MIN) deliberately aborts this statement when any preflight predicate fails.
SELECT abs(CASE WHEN
  ${predicates.join('\n  OR ')}
  THEN -9223372036854775808 ELSE 0 END) AS owner_authoritative_v2_preflight;`,
  ]
  for (const game of added.games) {
    statements.push(
      `INSERT INTO authoritative_games (id, identity_key, canonical_title, introduced_manifest_version, introduced_source_hash, created_on) VALUES (${sqlList([game.id, game.identityKey, game.canonicalTitle, game.manifestVersion, game.sourceHash, game.createdOn])});`,
    )
  }
  for (const score of added.scores) {
    statements.push(
      `INSERT INTO authoritative_mimma_score_versions (id, game_id, version, micro_score, meso_score, macro_score, micro_original_decimal, meso_original_decimal, macro_original_decimal, decimal_scale, rounding_mode, source_manifest_version, source_hash, provenance, approval_reason, approved_on) VALUES (${sqlString(score.id)}, ${sqlString(score.gameId)}, ${score.version}, ${score.micro}, ${score.meso}, ${score.macro}, ${sqlList([score.microOriginal, score.mesoOriginal, score.macroOriginal])}, 1, 'half-up-to-integer-v1', ${sqlList([score.manifestVersion, score.sourceHash])}, 'owner_authoritative', ${sqlList([score.approvalReason, score.approvedOn])});`,
    )
  }
  statements.push(
    `INSERT INTO authoritative_snapshots (id, version, manifest_version, source_hash, expected_member_count, state, created_on, frozen_on) VALUES (${sqlString(snapshot.id)}, ${snapshot.version}, ${sqlList([snapshot.manifestVersion, snapshot.sourceHash])}, ${snapshot.memberCount}, 'draft', ${sqlString(snapshot.createdOn)}, NULL);`,
  )
  for (const member of added.members) {
    statements.push(
      `INSERT INTO authoritative_snapshot_members (snapshot_id, game_id, score_id) VALUES (${sqlList([member.snapshotId, member.gameId, member.scoreId])});`,
    )
  }
  for (const mapping of added.mappings) {
    statements.push(
      `INSERT INTO authoritative_game_mappings (id, game_id, provider, external_id, catalog_game_id, mapping_version, decision, verification_ref, supersedes_mapping_id, source_manifest_version, source_hash, decided_on) VALUES (${sqlList([mapping.id, mapping.gameId, mapping.provider, mapping.externalId, mapping.catalogGameId])}, ${mapping.version}, ${sqlList([mapping.decision, mapping.verificationRef])}, NULL, ${sqlList([mapping.manifestVersion, mapping.sourceHash, mapping.decidedOn])});`,
    )
  }
  statements.push(
    `UPDATE authoritative_snapshots SET state = 'frozen', frozen_on = ${sqlString(snapshot.frozenOn)} WHERE id = ${sqlString(snapshot.id)} AND state = 'draft';`,
  )
  return `${statements.join('\n--> statement-breakpoint\n')}\n`
}

function readCatalog(): { id: string; steamAppId: number }[] {
  const parsed = JSON.parse(readFileSync(catalogPath, 'utf8')) as {
    games: { id: string; steamAppId: number }[]
  }
  return parsed.games
}

function normalizeLineEndings(content: string): string {
  return content.replace(/\r\n?/g, '\n')
}

function main(): void {
  const history = readOwnerAuthorityHistory(repositoryRoot)
  assertMappingsMatchCatalog(history.v2Rows, readCatalog())
  const migration = renderOwnerAuthoritativeMimmaV2Sql(history)
  if (process.argv.includes('--write')) {
    writeFileSync(v2MigrationPath, migration)
    process.stdout.write('Owner-authoritative MiMMa v2 migration generated.\n')
    return
  }
  let actual = ''
  try {
    actual = readFileSync(v2MigrationPath, 'utf8')
  } catch {
    // Reported as drift below.
  }
  if (normalizeLineEndings(actual) !== migration) {
    throw new Error(
      'Owner-authoritative MiMMa v2 migration drift detected. Run node scripts/generate-owner-authoritative-mimma-v2.mts --write.',
    )
  }
  process.stdout.write(
    `Owner-authoritative MiMMa v2 record ${EXPECTED_OWNER_AUTHORITATIVE_MIMMA_V2_SHA256.slice(0, 12)} matches its migration.\n`,
  )
}

if (process.argv[1] === fileURLToPath(import.meta.url)) {
  main()
}
